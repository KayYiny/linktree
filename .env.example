# === 数据库 ===
# 方式一：完整连接串（推荐，Supabase / Neon / 其他云 PG）
SUPABASE_URL=postgresql://postgres.xxxxx:your_password@host:5432/postgres

# 方式二：分项配置（自建 PostgreSQL）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=linktree
# DB_USER=postgres
# DB_PASSWORD=your_password

# === 认证 ===
JWT_SECRET=your_jwt_secret_change_this
ADMIN_PASSWORD=admin